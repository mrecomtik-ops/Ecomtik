# Contact form backend (see src/lib/contact-server-fn.ts).
# Sends directly via Gmail SMTP (smtp.gmail.com) using `worker-mailer`, a
# zero-dependency SMTP client built on Cloudflare Workers' native TCP
# sockets. Without these two variables, submissions are validated
# server-side but the enquiry is not sent — the form reports a real failure
# state rather than a fake success.

# The Gmail address that sends the enquiry email (e.g. mr.ecomtik@gmail.com).
GMAIL_USER=

# A Google "App Password" for that account — NOT the normal account
# password. Requires 2-Step Verification enabled on the Google account.
# Generate one at https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=

# Inbox that receives enquiry notifications. Defaults to mr.ecomtik@gmail.com if unset.
CONTACT_NOTIFY_EMAIL=

# IMPORTANT: smtp.gmail.com over Cloudflare Workers' `cloudflare:sockets` API
# only works in the real Workers runtime (a deployed Worker, or `wrangler dev`)
# — it is not available under `vite dev` (a plain Node process). Test the
# actual send path with `wrangler dev` or a real deploy, not `npm run dev`.
